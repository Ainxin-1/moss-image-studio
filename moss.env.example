# MOSS-Image Studio 本机配置模板。
# 复制为 moss.env（同目录）后按需修改；不写任何一项也能用默认值启动。
# 留空表示使用默认值。改完后重新启动 MOSS-Image 生效。

# ---- 服务 ----
# 端口，默认 1234
MOSS_PORT=1234
# 监听地址：127.0.0.1 = 只有本机能访问；0.0.0.0 = 同一局域网的手机/平板也能访问
MOSS_LISTEN=127.0.0.1
# 兼容旧版 sd-server 的额外参数，例如 MOSS_EXTRA_ARGS="--vae-tiling"
MOSS_EXTRA_ARGS=""

# ---- 文件位置（相对路径以程序目录为基准）----
# 一般不用改：Windows 默认用 bin/sd-server.exe，Linux/macOS 默认用 bin/sd-server
# MOSS_SERVER=bin/sd-server.exe
# 带中文语言包的界面
MOSS_HTML=web/index.html
# 模型根目录，传给 sd-server 的 --model-dir
MOSS_MODEL_DIR=models
# 扩散模型（DiT，Q4_K，约 3.3 GB）
MOSS_DIFFUSION_MODEL=models/MOSS-Image-SFT-Q4_K.gguf
# 文本编码器 Qwen3.5-9B（约 5.7 GB）
MOSS_TEXT_ENCODER=models/text_encoders/Qwen3.5-9B-Q4_K_M.gguf
# FLUX.2 VAE（约 0.34 GB）
MOSS_VAE=models/vae/flux2-vae.safetensors
# tokenizer.json
MOSS_TOKENIZER=models/tokenizers/tokenizer.json

# ---- 行为 ----
# 1 = 显存不够时把放不下的权重放到内存（8 GB 及以下显存建议开启）
MOSS_OFFLOAD_TO_CPU=1
# 1 = 关闭应用窗口后自动停止后台服务；0 = 服务继续运行（适合当局域网服务器）
MOSS_STOP_ON_EXIT=1
